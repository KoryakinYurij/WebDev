{
  "name": "mindfield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "tokens": "npm run validate:tokens && node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "bundle:check": "node scripts/check-bundle.mjs",
    "og": "node scripts/build-og.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm run bundle:check && npm run test:e2e"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
