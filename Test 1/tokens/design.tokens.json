{
  "color": {
    "ink": { "$type": "color", "$value": "#06060a", "$description": "Базовый фон, почти чёрный" },
    "void": { "$type": "color", "$value": "#000000" },
    "surface": { "$type": "color", "$value": "#0d0d14" },
    "surface-raised": { "$type": "color", "$value": "#15151f" },
    "line": { "$type": "color", "$value": "#2a2a38" },
    "fg": { "$type": "color", "$value": "#f2f2f7" },
    "fg-dim": { "$type": "color", "$value": "#a3a3b8" },
    "fg-faint": { "$type": "color", "$value": "#6a6a80" },
    "accent": {
      "lime": { "$type": "color", "$value": "#d4ff3f" },
      "magenta": { "$type": "color", "$value": "#ff2e88" },
      "indigo": { "$type": "color", "$value": "#5b3cff" },
      "cyan": { "$type": "color", "$value": "#00e8ff" }
    },
    "signal": {
      "ok": { "$type": "color", "$value": "#6dff8a" },
      "warn": { "$type": "color", "$value": "#ffb02e" }
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Space Grotesk", "Inter", "ui-sans-serif", "system-ui", "sans-serif"]
    },
    "display": {
      "$type": "fontFamily",
      "$value": ["Instrument Serif", "Iowan Old Style", "Georgia", "serif"]
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"]
    }
  },
  "size": {
    "mega": { "$type": "dimension", "$value": "clamp(3.4rem, 13.5vw, 15rem)", "$description": "Hero-гигант" },
    "display": { "$type": "dimension", "$value": "clamp(2.4rem, 7.2vw, 7rem)" },
    "title": { "$type": "dimension", "$value": "clamp(1.75rem, 4vw, 3.4rem)" },
    "heading": { "$type": "dimension", "$value": "clamp(1.25rem, 2.2vw, 1.9rem)" },
    "body": { "$type": "dimension", "$value": "clamp(1rem, 1.05vw, 1.15rem)" },
    "small": { "$type": "dimension", "$value": "0.875rem" },
    "label": { "$type": "dimension", "$value": "0.6875rem" }
  },
  "space": {
    "3xs": { "$type": "dimension", "$value": "0.25rem" },
    "2xs": { "$type": "dimension", "$value": "0.5rem" },
    "xs": { "$type": "dimension", "$value": "0.75rem" },
    "sm": { "$type": "dimension", "$value": "1rem" },
    "md": { "$type": "dimension", "$value": "1.5rem" },
    "lg": { "$type": "dimension", "$value": "2.5rem" },
    "xl": { "$type": "dimension", "$value": "clamp(3rem, 6vw, 6rem)" },
    "2xl": { "$type": "dimension", "$value": "clamp(5rem, 11vw, 12rem)" },
    "3xl": { "$type": "dimension", "$value": "clamp(7rem, 18vw, 20rem)" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "26px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "hair": { "$type": "dimension", "$value": "1px" },
    "thick": { "$type": "dimension", "$value": "2px" }
  },
  "duration": {
    "instant": { "$type": "duration", "$value": "90ms" },
    "fast": { "$type": "duration", "$value": "180ms" },
    "base": { "$type": "duration", "$value": "300ms" },
    "reveal": { "$type": "duration", "$value": "380ms" },
    "slow": { "$type": "duration", "$value": "700ms" },
    "cinematic": { "$type": "duration", "$value": "1400ms" }
  },
  "ease": {
    "out-expo": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1] },
    "out-quart": { "$type": "cubicBezier", "$value": [0.25, 1, 0.5, 1] },
    "in-quart": { "$type": "cubicBezier", "$value": [0.5, 0, 0.75, 0] },
    "in-out": { "$type": "cubicBezier", "$value": [0.83, 0, 0.17, 1] },
    "swift": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "content": { "$type": "number", "$value": 10 },
    "overlay": { "$type": "number", "$value": 40 },
    "nav": { "$type": "number", "$value": 60 },
    "cursor": { "$type": "number", "$value": 90 }
  },
  "motion": {
    "reveal-duration": { "$type": "number", "$value": 380, "$description": "мс, бюджет reveal-on-scroll" },
    "stagger": { "$type": "number", "$value": 46, "$description": "мс, шаг stagger" },
    "parallax-bg": { "$type": "number", "$value": 0.28, "$description": "доля скорости скролла" },
    "parallax-mid": { "$type": "number", "$value": 0.5 },
    "parallax-fg": { "$type": "number", "$value": 0.72 },
    "particles": { "$type": "number", "$value": 900 },
    "particles-low": { "$type": "number", "$value": 260 },
    "hero-points": { "$type": "number", "$value": 6000 },
    "hero-points-low": { "$type": "number", "$value": 2000 }
  }
}
